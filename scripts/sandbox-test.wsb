<!--
  Prueba del instalador en un Windows limpio (sin VC++, sin Python, sin nada).
  Doble clic en este archivo: abre Windows Sandbox con dist\installer montado
  en el escritorio en solo lectura. Al cerrarlo, todo se borra.
  Para probar sin internet, cambia Networking a Disable.
-->
<Configuration>
  <Networking>Default</Networking>
  <MappedFolders>
    <MappedFolder>
      <HostFolder>D:\SOFTWARE\MXP\MXP SUITE\MXPDOWNLOADER\VideoDownloader\dist\installer</HostFolder>
      <SandboxFolder>C:\Users\WDAGUtilityAccount\Desktop\Instalador</SandboxFolder>
      <ReadOnly>true</ReadOnly>
    </MappedFolder>
  </MappedFolders>
</Configuration>
